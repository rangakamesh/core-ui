{
  "name": "@rangakamesh/core-ui",
  "version": "0.1.0",
  "description": "Personal React UI kit and design tokens, styled after rangakamesh.net. Built for Next.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rangakamesh/core-ui.git",
    "directory": "packages/core-ui"
  },
  "homepage": "https://github.com/rangakamesh/core-ui#readme",
  "bugs": "https://github.com/rangakamesh/core-ui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/build-css.ts",
    "dev": "concurrently -k -n js,css \"tsup --watch\" \"node scripts/build-css.ts --watch\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "nextjs",
    "design-system",
    "ui",
    "design-tokens"
  ]
}
